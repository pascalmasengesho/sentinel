pkgname=sentinel-bounty
_pypi_name=sentinel_bounty
pkgver=0.1.0
pkgrel=1
pkgdesc='Safe reconnaissance assistant for authorized security assessments'
arch=('any')
url='https://github.com/pascalmasengesho/sentinel'
license=('MIT')
depends=(
  'python'
  'python-cryptography'
  'python-dnspython'
  'python-httpx'
  'python-pyyaml'
  'python-reportlab'
  'python-rich'
  'python-typer'
  'python-whois'
)
makedepends=('python-build' 'python-hatchling' 'python-installer' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/s/${pkgname}/${_pypi_name}-${pkgver}.tar.gz")
sha256sums=('1d3de01dfd1844b9da30f021abc6000a3235934fc6a4234517e57e0ab8f68514')

build() {
  cd "${srcdir}/${_pypi_name}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${_pypi_name}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
